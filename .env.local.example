# IUGU PAYMENT INTEGRATION CONFIGURATION
# Copy this file to .env.local and fill in your credentials

# Iugu API Token - Get from https://app.iugu.com/account
# Use test token for development: TEST_...
# Use live token for production: LIVE_...
IUGU_API_TOKEN=TEST_your_api_token_here

# Iugu Webhook Secret - Create webhook in Iugu dashboard
# Used to verify webhook authenticity
IUGU_WEBHOOK_SECRET=your_webhook_secret_here

# Iugu Account ID - Your account ID from Iugu dashboard
# This is used in the frontend for tokenization
NEXT_PUBLIC_IUGU_ACCOUNT_ID=your_account_id_here

# DEVELOPMENT CONFIGURATION
# Set to 'production' when deploying to production
NODE_ENV=development

# WEBHOOK SETUP INSTRUCTIONS:
# 1. Go to https://app.iugu.com/webhooks
# 2. Create a new webhook with URL: https://yourdomain.com/api/webhooks/iugu
# 3. Select the following events:
#    - invoice.created
#    - invoice.status_changed
#    - subscription.created
#    - subscription.suspended
#    - subscription.activated
#    - payment_method.created
# 4. Copy the webhook secret to IUGU_WEBHOOK_SECRET above

# IUGU PLANS SETUP:
# The following plans will be created automatically via API:
# - fitai_starter_monthly (R$ 19,97/month)
# - fitai_standard_monthly (R$ 29,97/month)
# - fitai_premium_monthly (R$ 49,97/month)
#
# To create plans manually, run:
# POST /api/iugu/plans (will create all plans at once)

# TEST CREDIT CARDS FOR DEVELOPMENT:
# Approved: 4111 1111 1111 1111
# Declined: 4000 0000 0000 0002
# CVV: any 3 digits
# Expiry: any future date (MM/YY format)